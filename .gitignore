# Local agent and downloaded runtime files
/.agents/
/.codex/
/.downloads/

# Keep the WordPress installation local. Version only the Hanova theme and setup guide.
/wordpress-clinic/*
!/wordpress-clinic/.gitignore
!/wordpress-clinic/LOCAL_SETUP.md
!/wordpress-clinic/Dockerfile
!/wordpress-clinic/docker/
!/wordpress-clinic/docker/**
!/wordpress-clinic/wp-content/
/wordpress-clinic/wp-content/*
!/wordpress-clinic/wp-content/themes/
/wordpress-clinic/wp-content/themes/*
!/wordpress-clinic/wp-content/themes/hanan-clinic/
!/wordpress-clinic/wp-content/themes/hanan-clinic/**

# Operating system and editor files
.DS_Store
Thumbs.db
*.swp
*.tmp

# Project-local tools and accidental database files
/laravel-medical-ecommerce/composer.phar
/laravel-medical-ecommerce/clinic_db
/laravel-medical-ecommerce/php.ini
/app/analysis_output*.txt
/app/final_analysis.txt
/app/android/.kotlin/
/laravel-medical-ecommerce/storage/framework/*.sqlite

# Never commit local environment or credential files
**/.env
**/.env.*
!**/.env.example
**/auth.json
**/*.keystore
**/*.jks
**/key.properties
**/local.properties
